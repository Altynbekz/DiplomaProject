{
  "name": "diploma-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "fmt": "prettier --write src tests *.ts *.json index.html",
    "fmt:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@tanstack/react-query": "5.108.3",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "vitest": "5.1.1",
    "jsdom": "31.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "8.0.0",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1"
  }
}

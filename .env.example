# Copy only when configuring manually; setup-local.py generates local secrets.
APP_OPERATOR_ID=local-operator
JUICE_SHOP_ORIGIN=http://juice-shop:3000
APP_LISTEN=127.0.0.1:8080
APP_API_TOKEN=<at-least-32-random-bytes-as-hex>
DATABASE_URL=postgres://diploma_runtime:<local-password>@127.0.0.1:<local-port>/diploma?sslmode=disable
MIGRATION_DATABASE_URL=postgres://diploma_migrate:<local-password>@127.0.0.1:<local-port>/diploma?sslmode=disable
